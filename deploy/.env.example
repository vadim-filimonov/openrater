# OpenRater demo deployment — configuration.
#
#   cp deploy/.env.example deploy/.env   then fill in the real values.
#   deploy/.env is git-ignored — never commit real values.
#
# The public address people visit. Must match the Cloudflare Access app
# hostname exactly (scheme + host, no trailing slash).
PUBLIC_URL=https://demo.yourdomain.com

# Cloudflare Tunnel token (Zero Trust dashboard -> Networks -> Tunnels ->
# your tunnel -> the long token in the install command).
CLOUDFLARE_TUNNEL_TOKEN=

# Your Cloudflare Zero Trust team domain (Settings -> Custom Pages, or the
# "<team>.cloudflareaccess.com" auth domain).
CF_ACCESS_TEAM_DOMAIN=yourteam.cloudflareaccess.com

# The Access application's Audience (AUD) tag (Access -> Applications ->
# your app -> Overview -> "Application Audience (AUD) Tag").
CF_ACCESS_AUD=

# OPTIONAL second gate (defense-in-depth) on top of the Cloudflare policy.
# Comma-separated emails. Leave blank to rely on Cloudflare Access alone.
# NOTE: changing this requires a redeploy; changing the Cloudflare policy
# does not — so prefer managing access in Cloudflare and leaving this blank.
OPERATOR_ALLOWLIST=

# OPTIONAL — only if you use the Google Maps enrichment connector.
GOOGLE_MAPS_API_KEY=

# OPTIONAL — control the bundled synthetic Meridian reference plan.
# It seeds by default so a fresh deployment is immediately usable.
#   1            seed the plan if absent (in-app edits survive restarts)
#   0            start without sample data
#   reset        restore the pristine plan on every boot
# The deploy accepts a blank value as the default (`1`), but keeping the
# value explicit makes the behavior clear.
SEED_COLD_TEST=1

# OPTIONAL — require an API key on POST /plans/{id}/quote.
#   blank  open behind Cloudflare Access; the in-app try-it works, and an
#          authenticated browser session is enough (default)
#   1      external callers must present a valid X-API-Key (mint one per plan
#          at POST /plans/{id}/api-keys); the in-app try-it still passes on
#          its operator session
QUOTE_REQUIRE_KEY=

# ---------------------------------------------------------------------------
# OPTIONAL — Litestream streaming backup (disaster recovery, RPO ~seconds).
# ---------------------------------------------------------------------------
# The `litestream` sidecar (deploy/docker-compose.yml) continuously ships
# the openrater.db WAL to an S3-compatible bucket. Leave
# LITESTREAM_BUCKET BLANK to keep it disabled — the sidecar starts, logs
# that it's off, and idles. Fill these in to turn it on, then redeploy.
# Bucket to replicate into (e.g. my-rater-backups). Blank = backup disabled.
LITESTREAM_BUCKET=
# Key prefix inside the bucket (keeps this deployment's data namespaced).
LITESTREAM_PATH=openrater
# S3 endpoint. Leave BLANK for AWS S3. For Cloudflare R2 set
#   https://<accountid>.r2.cloudflarestorage.com  (and LITESTREAM_REGION=auto).
LITESTREAM_ENDPOINT=
# Bucket region. AWS: the real region (e.g. us-east-1). R2: auto.
LITESTREAM_REGION=us-east-1
# Credentials for the bucket. Use a dedicated, least-privilege key that can
# only read/write this bucket (AWS IAM user or R2 API token).
LITESTREAM_ACCESS_KEY_ID=
LITESTREAM_SECRET_ACCESS_KEY=
