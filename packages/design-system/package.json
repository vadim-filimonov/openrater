{
  "name": "@openrater/design-system",
  "version": "0.0.0",
  "private": true,
  "description": "The OpenRater visual language: design tokens (color, type, spacing, motion, radius, shadow) + the base primitive component set (Button, IconButton, Chip, Card, Kbd, Divider, Label, Num, etc.). Dark mode default; light mode opt-in via [data-theme=\"light\"]. BEM CSS via tokens. lucide SVG icons. WCAG AA verified both modes. Re-authored from the original prototype's v2 styles — same intent, cleaner semantic layering. See docs/specs/platform-model.md §5.",
  "license": "Apache-2.0",
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./src/index.ts"
    },
    "./error-bus": {
      "types": "./src/primitives/GlobalErrorSurface/apiErrorBus.ts",
      "import": "./src/primitives/GlobalErrorSurface/apiErrorBus.ts"
    },
    "./tokens.css": "./src/tokens.css"
  },
  "files": [
    "src",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc --noEmit",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "lucide-react": "^0.453.0"
  },
  "peerDependencies": {
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^6.5.0",
    "@testing-library/react": "^16.0.1",
    "@testing-library/user-event": "^14.5.2",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.3",
    "jsdom": "^25.0.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "typescript": "^5.6.3",
    "vitest": "^2.1.4"
  }
}
