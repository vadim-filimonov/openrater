{
  "name": "V39.derive-territory-zip",
  "description": "ADR-0038 — ZIP-granularity territory rollup (the Sample BOP acceptance shape). A risk carrying ZIP '66101' resolves THROUGH a `derive.territory` node (ZIP → territory id, map built from the geo dim's geo_territories members) onto territory '701', then a territory-keyed `lookup.direct` returns 1.20. Same mechanism as V22 but at ZIP granularity instead of state — proving the territory layer is granularity-agnostic. The map self-maps an ungrouped ZIP ('67999') per the mixed model; the ungrouped-tail input case is V25.",
  "plan": {
    "id": "v24.derive_territory_zip",
    "version": "1.0.0",
    "name": "ZIP territory rollup (66101 → 701 → 1.20)",
    "line": "bop",
    "effective": "2026-01-01",
    "nodes": [
      {
        "id": "in_zip",
        "kind": "input",
        "params": { "fieldName": "zip", "fieldType": "string" },
        "position": { "x": 0, "y": 0 }
      },
      {
        "id": "terr_zip",
        "kind": "derive.territory",
        "params": {
          "dimSlug": "territory",
          "territoryMap": {
            "66101": "701", "66102": "701",
            "67201": "702", "67203": "702",
            "67999": "67999"
          },
          "territoryLabels": {
            "701": "Kansas City / Wyandotte metro",
            "702": "Remainder of state"
          }
        },
        "position": { "x": 200, "y": 0 }
      },
      {
        "id": "lkp_territory",
        "kind": "lookup.direct",
        "params": {
          "table": { "701": 1.20, "702": 0.90, "67999": 1.05 },
          "defaultValue": 1.0,
          "tableName": "KS territory base-loss-cost factor"
        },
        "position": { "x": 400, "y": 0 }
      },
      {
        "id": "out_factor",
        "kind": "output",
        "params": { "fieldName": "factor", "fieldType": "float" },
        "position": { "x": 600, "y": 0 }
      },
      {
        "id": "out_unmapped",
        "kind": "output",
        "params": { "fieldName": "unmapped", "fieldType": "bool" },
        "position": { "x": 600, "y": 120 }
      }
    ],
    "edges": [
      { "from": { "node": "in_zip",        "port": "value" },        "to": { "node": "terr_zip",      "port": "value"    } },
      { "from": { "node": "terr_zip",      "port": "territory_id" }, "to": { "node": "lkp_territory", "port": "key"      } },
      { "from": { "node": "terr_zip",      "port": "unmapped" },     "to": { "node": "out_unmapped",  "port": "value"    } },
      { "from": { "node": "lkp_territory", "port": "value" },        "to": { "node": "out_factor",    "port": "value"    } }
    ]
  },
  "externalInputs": { "zip": "66101" },
  "expectedOutputs": { "factor": 1.20, "unmapped": false }
}
