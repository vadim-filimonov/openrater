{
  "name": "V59.class-attribute-override",
  "description": "Brief 83 (TV-19) — derive.class_attribute's optional `override` input: a DECLARED, non-empty override supersedes the class-derived attribute. ISO BOP's exposure-basis election: occupant class 53983 derives basis `loi` (factor 1.25), but the declared `lessors_loi` election wins the derive, so the downstream lookup resolves the lessors factor 0.4. An absent/blank override falls through to the derivation (pinned by unit tests; the wire shape here pins the override path).",
  "plan": {
    "id": "v59.class_attribute_override",
    "version": "1.0.0",
    "name": "Class-attribute declared override",
    "lines": ["liability"],
    "effective": "2026-01-01",
    "nodes": [
      {
        "id": "in_class",
        "kind": "input",
        "params": { "fieldName": "class_code", "fieldType": "string" },
        "position": { "x": 0, "y": 0 }
      },
      {
        "id": "in_override",
        "kind": "input",
        "params": { "fieldName": "liab_exposure_basis_override", "fieldType": "string" },
        "position": { "x": 0, "y": 120 }
      },
      {
        "id": "derive_base",
        "kind": "derive.class_attribute",
        "params": {
          "attributeKey": "liab_exposure_base",
          "table": { "53983": "loi" },
          "tableName": "class_code → liab_exposure_base"
        },
        "position": { "x": 200, "y": 60 }
      },
      {
        "id": "lk_base_factor",
        "kind": "lookup.direct",
        "params": {
          "table": { "loi": 1.25, "lessors_loi": 0.4 },
          "defaultValue": 1.0,
          "tableName": "Base loss cost by exposure basis"
        },
        "position": { "x": 400, "y": 60 }
      },
      {
        "id": "out_factor",
        "kind": "output",
        "params": { "fieldName": "factor", "fieldType": "factor" },
        "position": { "x": 600, "y": 60 }
      }
    ],
    "edges": [
      { "from": { "node": "in_class", "port": "value" }, "to": { "node": "derive_base", "port": "class_code" } },
      { "from": { "node": "in_override", "port": "value" }, "to": { "node": "derive_base", "port": "override" } },
      { "from": { "node": "derive_base", "port": "value" }, "to": { "node": "lk_base_factor", "port": "key" } },
      { "from": { "node": "lk_base_factor", "port": "value" }, "to": { "node": "out_factor", "port": "value" } }
    ]
  },
  "externalInputs": { "class_code": "53983", "liab_exposure_basis_override": "lessors_loi" },
  "expectedOutputs": { "factor": 0.4 }
}
