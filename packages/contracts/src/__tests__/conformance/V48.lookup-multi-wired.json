{
  "name": "V48.lookup-multi-wired",
  "description": "lookup.multi wired via derived per-key ports (ADR-0044): (territory, exposure_base) -> liability base loss cost. Two upstream inputs feed two named key ports.",
  "plan": {
    "id": "v48.multi",
    "version": "1.0.0",
    "name": "Multi-key lookup (wired per-key ports)",
    "line": "bop",
    "effective": "2026-01-01",
    "nodes": [
      { "id": "in_terr", "kind": "input", "params": { "fieldName": "territory", "fieldType": "string" }, "position": { "x": 0, "y": 0 } },
      { "id": "in_exp", "kind": "input", "params": { "fieldName": "exposure_base", "fieldType": "string" }, "position": { "x": 0, "y": 120 } },
      { "id": "lkp", "kind": "lookup.multi",
        "params": {
          "keyNames": ["territory", "exposure_base"],
          "rows": [
            { "keys": ["701", "loi"], "factor": 0.025 },
            { "keys": ["701", "sales"], "factor": 1.518 },
            { "keys": ["701", "payroll"], "factor": 10.214 },
            { "keys": ["702", "loi"], "factor": 0.029 },
            { "keys": ["702", "sales"], "factor": 1.577 },
            { "keys": ["702", "payroll"], "factor": 10.419 }
          ],
          "defaultValue": 1.0,
          "tableName": "base_lc_liability"
        },
        "position": { "x": 220, "y": 60 } },
      { "id": "out_f", "kind": "output", "params": { "fieldName": "base_lc", "fieldType": "float" }, "position": { "x": 440, "y": 60 } }
    ],
    "edges": [
      { "from": { "node": "in_terr", "port": "value" }, "to": { "node": "lkp", "port": "territory" } },
      { "from": { "node": "in_exp", "port": "value" }, "to": { "node": "lkp", "port": "exposure_base" } },
      { "from": { "node": "lkp", "port": "value" }, "to": { "node": "out_f", "port": "value" } }
    ]
  },
  "externalInputs": { "territory": "702", "exposure_base": "sales" },
  "expectedOutputs": { "base_lc": 1.577 }
}
