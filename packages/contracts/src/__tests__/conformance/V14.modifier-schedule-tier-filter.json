{
  "name": "V14.modifier-schedule-tier-filter",
  "description": "modifier.schedule + eligibility.gate: a 'preferred-only' category is skipped when the tier verdict is 'standard' (Brief 15 P-M9 + Brief 10).",
  "plan": {
    "id": "v14.modifier_tier_filter",
    "version": "1.0.0",
    "name": "Schedule modifier + tier filter",
    "lines": ["liability"],
    "effective": "2026-01-01",
    "nodes": [
      { "id": "app", "kind": "input", "params": { "fieldName": "schedule_application", "fieldType": "money" }, "position": { "x": 0, "y": 0 } },
      {
        "id": "gate",
        "kind": "eligibility.gate",
        "params": {
          "rules": [
            { "rule_id": "core_market", "variable": "state", "op": "in", "value": ["WI", "MN"], "tier": "preferred", "reasoning": "Core market." }
          ],
          "default_tier": "standard",
          "default_reasoning": "Standard appetite."
        },
        "position": { "x": 0, "y": 100 }
      },
      {
        "id": "mod",
        "kind": "modifier.schedule",
        "params": {
          "schedule": {
            "schedule_id": "liability_schedule",
            "display_name": "Liability schedule mod",
            "scope": "per_coverage",
            "total_cap_pct": 25,
            "categories": [
              { "category_id": "premier_only", "name": "Premier underwriter discount", "range_pct": 5, "reasoning_required": false, "tier_filter": ["preferred"] },
              { "category_id": "safety", "name": "Safety devices", "range_pct": 5, "reasoning_required": true }
            ]
          }
        },
        "position": { "x": 200, "y": 50 }
      },
      { "id": "out_factor", "kind": "output", "params": { "fieldName": "factor", "fieldType": "factor" }, "position": { "x": 400, "y": 0 } },
      { "id": "out_pct", "kind": "output", "params": { "fieldName": "applied_pct", "fieldType": "pct" }, "position": { "x": 400, "y": 100 } }
    ],
    "edges": [
      { "from": { "node": "app", "port": "value" }, "to": { "node": "mod", "port": "application" } },
      { "from": { "node": "gate", "port": "tier" }, "to": { "node": "mod", "port": "tier" } },
      { "from": { "node": "mod", "port": "factor" }, "to": { "node": "out_factor", "port": "value" } },
      { "from": { "node": "mod", "port": "applied_pct" }, "to": { "node": "out_pct", "port": "value" } }
    ]
  },
  "externalInputs": {
    "state": "TX",
    "schedule_application": {
      "schedule_id": "liability_schedule",
      "values": {
        "premier_only": { "value_pct": -5, "reasoning": "Would apply if tier preferred.", "source": "underwriter" },
        "safety": { "value_pct": -3, "reasoning": "Sprinklers.", "source": "underwriter" }
      }
    }
  },
  "expectedOutputs": {
    "factor": 0.97,
    "applied_pct": -3
  }
}
