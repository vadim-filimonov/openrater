{
  "name": "V24.derive-class-attribute",
  "description": "ADR-0035 (Brief 51) — a class code drives a DERIVED structural dimension. class_code='53983' resolves THROUGH a `derive.class_attribute` node (class_code → prop_rate_number, map snapshotted from the plan's class registry) onto rate number '09', then a rate-number-keyed `lookup.direct` returns 1.504. Proves the runtime honors the class→derived-attribute layer the ISO BOP filing needs: the factor table keys off the DERIVED value, not the raw class code (which would miss every row). This is the class→string-attribute path; the class→number-factor path is lookup.classification (V8/V9).",
  "plan": {
    "id": "v24.derive_class_attribute",
    "version": "1.0.0",
    "name": "Class-attribute derivation (53983 → rate 09 → 1.504)",
    "line": "bop",
    "effective": "2026-01-01",
    "nodes": [
      {
        "id": "in_class",
        "kind": "input",
        "params": { "fieldName": "class_code", "fieldType": "string" },
        "position": { "x": 0, "y": 0 }
      },
      {
        "id": "derive_rate_no",
        "kind": "derive.class_attribute",
        "params": {
          "attributeKey": "prop_rate_number",
          "tableName": "ISO BOP class table",
          "table": {
            "09015": "18",
            "09033": "19",
            "53983": "09",
            "62106": "01"
          }
        },
        "position": { "x": 200, "y": 0 }
      },
      {
        "id": "lkp_rate_no",
        "kind": "lookup.direct",
        "params": {
          "table": { "01": 1.0, "09": 1.504, "18": 0.92, "19": 0.88 },
          "defaultValue": 1.0,
          "tableName": "Rate Number relativity (building)"
        },
        "position": { "x": 400, "y": 0 }
      },
      {
        "id": "out_factor",
        "kind": "output",
