    ],
    "adjustments": [
      { "kind": "schedule_rating", "id": "irpm", "display_name": "Schedule rating (connector)", "cap_pct": 25, "source": { "from": "connector", "connector_id": "loss_geo", "version": "v3" }, "citation": "API Lab · loss_geo v3 · snapshot es_fixture8" },
