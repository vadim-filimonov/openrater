{
  "name": "V49.exposure-rated-tower",
  "description": "ADR-0044: exposure-rated coverage tower as the projector emits it — chain.mult(relativities) -> round(3) -> ÷exposure -> ×LCM -> round(0). rate 0.389×1.504=0.585056 -> 0.585 -> ×(200000/100=2000) -> ×1.401 -> 1639.",
  "plan": {
    "id": "v49.exposure-tower",
    "version": "1.0.0",
    "name": "Exposure-rated tower (ISO Rule 23 close-out)",
    "line": "bop",
    "effective": "2026-01-01",
    "nodes": [
      { "id": "in_terr", "kind": "input", "params": { "fieldName": "territory", "fieldType": "string" }, "position": { "x": 0, "y": 0 } },
      { "id": "in_rateno", "kind": "input", "params": { "fieldName": "prop_rate_number", "fieldType": "string" }, "position": { "x": 0, "y": 60 } },
      { "id": "in_limit", "kind": "input", "params": { "fieldName": "building_limit", "fieldType": "money" }, "position": { "x": 0, "y": 120 } },

      { "id": "base", "kind": "constant", "params": { "value": 1.0, "type": "factor" }, "position": { "x": 200, "y": 0 } },
      { "id": "base_lc", "kind": "lookup.direct", "params": { "table": { "701": 0.389, "702": 0.389 }, "defaultValue": 1.0, "tableName": "base_lc_property · building" }, "position": { "x": 200, "y": 40 } },
      { "id": "rate_no", "kind": "lookup.direct", "params": { "table": { "09": 1.504, "25": 1.311 }, "defaultValue": 1.0, "tableName": "rate_number_rel · building" }, "position": { "x": 200, "y": 80 } },

      { "id": "mul", "kind": "chain.mult", "params": { "factorNames": ["base_lc", "rate_no"], "stopOnZero": false }, "position": { "x": 400, "y": 40 } },
      { "id": "rate3", "kind": "round", "params": { "decimals": 3 }, "position": { "x": 560, "y": 40 } },

      { "id": "divisor", "kind": "constant", "params": { "value": 100, "type": "number" }, "position": { "x": 400, "y": 140 } },
      { "id": "expdiv", "kind": "math.op", "params": { "op": "div" }, "position": { "x": 560, "y": 120 } },

      { "id": "mulexp", "kind": "math.op", "params": { "op": "mul" }, "position": { "x": 700, "y": 80 } },
      { "id": "lcm", "kind": "constant", "params": { "value": 1.401, "type": "factor" }, "position": { "x": 700, "y": 160 } },
      { "id": "mullcm", "kind": "math.op", "params": { "op": "mul" }, "position": { "x": 840, "y": 100 } },
      { "id": "prem", "kind": "round", "params": { "decimals": 0 }, "position": { "x": 980, "y": 100 } },
      { "id": "out", "kind": "output", "params": { "fieldName": "building_premium", "fieldType": "money" }, "position": { "x": 1120, "y": 100 } }
    ],
    "edges": [
      { "from": { "node": "in_terr", "port": "value" }, "to": { "node": "base_lc", "port": "key" } },
      { "from": { "node": "in_rateno", "port": "value" }, "to": { "node": "rate_no", "port": "key" } },

      { "from": { "node": "base", "port": "value" }, "to": { "node": "mul", "port": "base" } },
      { "from": { "node": "base_lc", "port": "value" }, "to": { "node": "mul", "port": "factors" } },
      { "from": { "node": "rate_no", "port": "value" }, "to": { "node": "mul", "port": "factors" } },
      { "from": { "node": "mul", "port": "result" }, "to": { "node": "rate3", "port": "value" } },

      { "from": { "node": "in_limit", "port": "value" }, "to": { "node": "expdiv", "port": "x" } },
      { "from": { "node": "divisor", "port": "value" }, "to": { "node": "expdiv", "port": "y" } },

      { "from": { "node": "rate3", "port": "value" }, "to": { "node": "mulexp", "port": "x" } },
      { "from": { "node": "expdiv", "port": "result" }, "to": { "node": "mulexp", "port": "y" } },

      { "from": { "node": "mulexp", "port": "result" }, "to": { "node": "mullcm", "port": "x" } },
      { "from": { "node": "lcm", "port": "value" }, "to": { "node": "mullcm", "port": "y" } },

      { "from": { "node": "mullcm", "port": "result" }, "to": { "node": "prem", "port": "value" } },
      { "from": { "node": "prem", "port": "value" }, "to": { "node": "out", "port": "value" } }
    ]
  },
  "externalInputs": { "territory": "702", "prop_rate_number": "09", "building_limit": 200000 },
  "expectedOutputs": { "building_premium": 1639 }
}
