{
  "name": "V40.derive-territory-ungrouped-tail",
  "description": "ADR-0038 mixed model — a geo dim where MOST levels roll into territories (66101→701) but one ZIP is left UNGROUPED. The projector self-maps the ungrouped ZIP ('67999' → '67999') so it rates on ITSELF (1.05) via the same territory-keyed lookup, instead of silently dropping to the 1.0 default the way the pre-ADR-0038 grid (which dropped ungrouped levels) would have. Proves the 'territory-when-grouped, else level' key space is rateable end-to-end, not just for fully-grouped dims. Companion to V24 (grouped ZIP) — identical plan, ungrouped input.",
  "plan": {
    "id": "v25.derive_territory_ungrouped_tail",
    "version": "1.0.0",
    "name": "Mixed-model ungrouped tail (67999 → 67999 → 1.05)",
    "line": "bop",
    "effective": "2026-01-01",
    "nodes": [
      {
        "id": "in_zip",
        "kind": "input",
        "params": { "fieldName": "zip", "fieldType": "string" },
        "position": { "x": 0, "y": 0 }
      },
      {
        "id": "terr_zip",
        "kind": "derive.territory",
        "params": {
          "dimSlug": "territory",
          "territoryMap": {
            "66101": "701", "66102": "701",
            "67201": "702", "67203": "702",
            "67999": "67999"
          },
          "territoryLabels": {
            "701": "Kansas City / Wyandotte metro",
            "702": "Remainder of state"
          }
        },
        "position": { "x": 200, "y": 0 }
      },
      {
        "id": "lkp_territory",
        "kind": "lookup.direct",
        "params": {
          "table": { "701": 1.20, "702": 0.90, "67999": 1.05 },
          "defaultValue": 1.0,
          "tableName": "KS territory base-loss-cost factor"
        },
        "position": { "x": 400, "y": 0 }
      },
      {
        "id": "out_factor",
        "kind": "output",
        "params": { "fieldName": "factor", "fieldType": "float" },
        "position": { "x": 600, "y": 0 }
      },
      {
        "id": "out_unmapped",
        "kind": "output",
        "params": { "fieldName": "unmapped", "fieldType": "bool" },
        "position": { "x": 600, "y": 120 }
      }
    ],
    "edges": [
      { "from": { "node": "in_zip",        "port": "value" },        "to": { "node": "terr_zip",      "port": "value"    } },
      { "from": { "node": "terr_zip",      "port": "territory_id" }, "to": { "node": "lkp_territory", "port": "key"      } },
      { "from": { "node": "terr_zip",      "port": "unmapped" },     "to": { "node": "out_unmapped",  "port": "value"    } },
      { "from": { "node": "lkp_territory", "port": "value" },        "to": { "node": "out_factor",    "port": "value"    } }
    ]
  },
  "externalInputs": { "zip": "67999" },
  "expectedOutputs": { "factor": 1.05, "unmapped": false }
}
