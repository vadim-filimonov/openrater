{
  "name": "V18.endorsement-rate-branch",
  "description": "endorsement.rate_branch composition test. Per Brief 40 §−1 + Brief 42 §−1: when trigger fires, the branch_chain runs as a mini-chain whose output is ADDED (additive composition per Brief 40 §−1 Q3) to the incoming premium. Branch LCM is independent of the main chain per Brief 42 §−1 Q5. STATUS: ✓ implemented in Phase H.4 — EndorsementRateBranchKind is registered as a builtin; this fixture executes as part of the conformance suite.",
  "plan": {
    "id": "v18.endorsement_rate_branch",
    "version": "1.0.0",
    "name": "Endorsement rate-branch composition",
    "lines": ["property"],
    "effective": "2026-01-01",
    "nodes": [
      {
        "id": "base",
        "kind": "constant",
        "params": { "value": 1000 },
        "position": { "x": 0, "y": 0 }
      },
      {
        "id": "end_branch",
        "kind": "endorsement.rate_branch",
        "params": {
          "form_number": "CG-2147",
