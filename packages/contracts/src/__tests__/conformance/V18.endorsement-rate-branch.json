            "factor_lookups": [],
            "lcm": {
              "factor_kind": "lcm",
              "input_path": "form_input.lcm",
              "citation_rule": "(carrier-set)",
              "citation_page": "(carrier-set)",
              "description_template": "Loss Cost Multiplier (carrier): {value}"
            },
            "exposure_input": "form_input.liquor_receipts",
            "exposure_unit_divisor": 1,
            "output_field": "liquor_premium"
          }
        },
        "position": { "x": 200, "y": 0 }
      },
      {
        "id": "out_premium",
        "kind": "output",
        "params": { "fieldName": "final_premium", "fieldType": "number" },
