    "edges": [
      { "from": { "node": "base", "port": "value" }, "to": { "node": "end_branch", "port": "premium" } },
      { "from": { "node": "end_branch", "port": "premium_out" }, "to": { "node": "out_premium", "port": "value" } },
      { "from": { "node": "end_branch", "port": "contribution" }, "to": { "node": "out_contribution", "port": "value" } },
      { "from": { "node": "end_branch", "port": "fired" }, "to": { "node": "out_fired", "port": "value" } }
    ]
  },
  "externalInputs": {
    "has_liquor_sales": true,
    "liquor_receipts": 500,
    "lcm": 1.0
