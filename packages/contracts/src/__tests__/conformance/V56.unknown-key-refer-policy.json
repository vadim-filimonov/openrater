{
  "name": "V56.unknown-key-refer-policy",
  "description": "ADR-0056 - unknown lookup key with onMiss refer rates 1.0 INDICATIVE and escalates eligibility to submit (most-restrictive-wins, even with no gate in the plan).",
  "plan": {
    "id": "v56.unknown-key-refer",
    "version": "1.0.0",
    "name": "Unknown key - refer policy",
    "effective": "2026-01-01",
    "nodes": [
      { "id": "in_cls", "kind": "input", "params": { "fieldName": "class_code", "fieldType": "string" }, "position": { "x": 0, "y": 0 } },
      { "id": "const_base", "kind": "constant", "params": { "value": 100, "type": "money" }, "position": { "x": 0, "y": 100 } },
      { "id": "lkp", "kind": "lookup.direct",
        "params": { "table": { "73911": 1.0, "73912": 1.32 }, "defaultValue": 1.0, "tableName": "class_rel", "keySource": "class_code", "onMiss": { "mode": "refer" } },
        "position": { "x": 200, "y": 0 } },
      { "id": "chain", "kind": "chain.mult", "params": { "factorNames": ["class_rel"], "stopOnZero": false }, "position": { "x": 400, "y": 0 } },
      { "id": "out_p", "kind": "output", "params": { "fieldName": "premium", "fieldType": "money" }, "position": { "x": 600, "y": 0 } }
    ],
    "edges": [
      { "from": { "node": "in_cls", "port": "value" }, "to": { "node": "lkp", "port": "key" } },
      { "from": { "node": "const_base", "port": "value" }, "to": { "node": "chain", "port": "base" } },
      { "from": { "node": "lkp", "port": "value" }, "to": { "node": "chain", "port": "factors" } },
      { "from": { "node": "chain", "port": "result" }, "to": { "node": "out_p", "port": "value" } }
    ]
  },
  "externalInputs": { "class_code": "99999" },
  "expectedOutputs": { "premium": 100 },
  "expectedRowStatus": "ok",
  "expectedIssues": [
    { "nodeId": "lkp", "code": "unknown_key_referred", "severity": "warning" }
  ],
  "expectedEligibilityTier": "submit"
}
