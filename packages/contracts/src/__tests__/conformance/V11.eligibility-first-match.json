{
  "name": "V11.eligibility-first-match",
  "description": "eligibility.gate walks rules in order; first match wins. WI restaurant with 5 yrs in business hits core_market → preferred (Brief 10).",
  "plan": {
    "id": "v11.eligibility_first_match",
    "version": "1.0.0",
    "name": "Eligibility first-match",
    "lines": ["liability"],
    "effective": "2026-01-01",
    "nodes": [
      {
        "id": "gate",
        "kind": "eligibility.gate",
        "params": {
          "rules": [
            { "rule_id": "new_venture", "variable": "years_in_business", "op": "lt", "value": 1, "tier": "decline", "reasoning": "New ventures excluded per appetite guidelines." },
            { "rule_id": "core_market", "variable": "state", "op": "in", "value": ["WI", "MN", "IL"], "tier": "preferred", "reasoning": "Core market state." },
            { "rule_id": "high_revenue", "variable": "annual_sales", "op": "gt", "value": 5000000, "tier": "submit", "reasoning": "High-revenue accounts require manual review." }
          ],
          "default_tier": "standard",
          "default_reasoning": "Standard appetite, no special handling."
        },
        "position": { "x": 0, "y": 0 }
      },
      { "id": "out_tier", "kind": "output", "params": { "fieldName": "tier", "fieldType": "string" }, "position": { "x": 200, "y": 0 } }
    ],
    "edges": [
      { "from": { "node": "gate", "port": "tier" }, "to": { "node": "out_tier", "port": "value" } }
    ]
  },
  "externalInputs": { "years_in_business": 5, "state": "WI", "annual_sales": 1000000 },
  "expectedOutputs": { "tier": "preferred" }
}
