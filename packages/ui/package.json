{
  "name": "@openrater/ui",
  "version": "0.0.0",
  "private": true,
  "description": "OpenRater components for insurance-rating concepts, composed from @openrater/contracts and @openrater/design-system. No HTTP, app state, or routing.",
  "license": "Apache-2.0",
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./src/index.ts"
    },
    "./InputsWorkspace/stagesToRuntimePlan": {
      "types": "./src/InputsWorkspace/stagesToRuntimePlan.ts",
      "import": "./src/InputsWorkspace/stagesToRuntimePlan.ts"
    },
    "./AnalyticsWorkspace/snapshot-plan": {
      "types": "./src/AnalyticsWorkspace/snapshot-plan.ts",
      "import": "./src/AnalyticsWorkspace/snapshot-plan.ts"
    },
    "./AnalyticsWorkspace/premium-resolution": {
      "types": "./src/AnalyticsWorkspace/premium-resolution.ts",
      "import": "./src/AnalyticsWorkspace/premium-resolution.ts"
    },
    "./InputsWorkspace/policyBookConfig": {
      "types": "./src/InputsWorkspace/policyBookConfig.ts",
      "import": "./src/InputsWorkspace/policyBookConfig.ts"
    },
    "./InputsWorkspace/projectRowsForBatch": {
      "types": "./src/InputsWorkspace/projectRowsForBatch.ts",
      "import": "./src/InputsWorkspace/projectRowsForBatch.ts"
    },
    "./InputsWorkspace/deriveRequiredInputs": {
      "types": "./src/InputsWorkspace/deriveRequiredInputs.ts",
      "import": "./src/InputsWorkspace/deriveRequiredInputs.ts"
    }
  },
  "files": [
    "src",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc --noEmit",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@openrater/contracts": "workspace:*",
    "@openrater/design-system": "workspace:*",
    "@xyflow/react": "^12.3.5",
    "d3-geo": "^3.1.1",
    "lucide-react": "^0.453.0",
    "topojson-client": "^3.1.0",
    "us-atlas": "^3.0.1"
  },
  "peerDependencies": {
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^6.5.0",
    "@testing-library/react": "^16.0.1",
    "@testing-library/user-event": "^14.5.2",
    "@types/d3-geo": "^3.1.0",
    "@types/geojson": "^7946.0.16",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@types/topojson-client": "^3.1.5",
    "@types/topojson-specification": "^1.0.5",
    "@vitejs/plugin-react": "^4.3.3",
    "jsdom": "^25.0.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "typescript": "^5.6.3",
    "vitest": "^2.1.4"
  }
}
