{
  "name": "@openrater/hooks",
  "version": "0.0.0",
  "private": true,
  "description": "React hooks: TanStack Query wiring around @openrater/api-client, react-hook-form + Zod helpers, cross-feature hooks (useActiveDraft, usePlanCanvasState, etc.). The composition layer between data + UI.",
  "license": "Apache-2.0",
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./src/index.ts"
    }
  },
  "files": ["src", "README.md", "LICENSE"],
  "scripts": {
    "build": "tsc --noEmit",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@openrater/api-client": "workspace:*",
    "@openrater/contracts": "workspace:*",
    "@openrater/design-system": "workspace:*",
    "@tanstack/react-query": "^5.59.0",
    "react-hook-form": "^7.53.0",
    "@hookform/resolvers": "^3.9.0",
    "zod": "^3.23.8"
  },
  "peerDependencies": {
    "react": "^18.3.1"
  },
  "devDependencies": {
    "@types/react": "^18.3.12",
    "react": "^18.3.1",
    "typescript": "^5.6.3",
    "vitest": "^2.1.4"
  }
}
