{
  "id": "IC10",
  "name": "validity-pins",
  "spec": "§4.2 rule 5",
  "asserts": "Every quote-set member carries the pins that make its premium replayable forever: version kind + snapshot + content hash, as_of, and valid_until.",
  "contract_version": "1.0",
  "world": {
    "integration": { "name": "Example Integrator — fixture", "paired": true },
    "plans": ["plan-alpha", "plan-beta"]
  },
  "steps": [
    {
      "note": "a plain fan-out quote; the assertions are all about the pins",
      "actor": "integrator",
      "call": {
        "method": "POST",
        "path": "/api/v1/integrations/{{integration_id}}/quote-set",
        "headers": { "X-OpenRater-Integration-Key": "{{integrator_key}}" },
        "body": {
          "risk_ref": "r-fixture-0008",
          "request_hash": "sha256:ic10-fixture",
          "effective_date": "2026-08-01",
          "trace": "none",
          "facts": {
            "rest.gross_receipts": 1250000,
            "property.construction": "JM",
            "property.tiv": 1500000
          }
        }
      },
      "expect": {
        "status": 200,
        "body": {
          "as_of": "2026-08-01",
          "contract_version": "1.0",
          "quotes": [
            {
              "carrier": "acme-mutual",
              "version": {
                "kind": "published",
                "snapshot_id": { "$type": "string" },
                "content_hash": { "$type": "string" }
              },
              "valid_until": { "$type": "string" }
            },
            {
              "carrier": "birch-specialty",
              "version": {
                "kind": "published",
                "snapshot_id": { "$type": "string" },
                "content_hash": { "$type": "string" }
              },
              "valid_until": { "$type": "string" }
            }
          ]
        }
      }
    }
  ]
}
