# ─────────────────────────────────────────────────────────────────────────────
# OpenRater server — optional connector secrets (safe to commit)
#
# This file documents the secrets that implemented connectors accept. It holds
# no real values. Copy it to `server/.env`, which is git-ignored:
#
#     cp server/.env.example server/.env
#
# Never put a real key in this file.
# ─────────────────────────────────────────────────────────────────────────────

# Google Maps Platform — Address Validation / Geocoding / Places.
# Maps to connector secret_ref `secret://google/maps_api_key`.
RATER_GOOGLE_MAPS_API_KEY=
