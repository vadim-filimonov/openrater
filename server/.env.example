# ─────────────────────────────────────────────────────────────────────────────
# OpenRater · API Lab — connector secrets TEMPLATE (safe to commit)
#
# This file documents which secrets the API Lab connectors expect. It holds NO
# real values. Copy it to `.env` (which is git-ignored) and fill in real keys there:
#
#     cp api-lab/backend/.env.example api-lab/backend/.env
#
# Never put a real key in THIS file — only in `.env`.
# ─────────────────────────────────────────────────────────────────────────────

# Google Maps Platform — Address Validation / Geocoding / Places.
# Maps to connector secret_ref `secret://google/maps_api_key` (Brief 47 §4.1).
RATER_GOOGLE_MAPS_API_KEY=AIzaSyExample-replace-with-your-real-key

# Future connectors (uncomment + fill in .env as you wire them):
# RATER_VERISK_API_KEY=
# RATER_DNB_API_KEY=
# RATER_CAPE_API_KEY=
