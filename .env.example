# OpenRater — development environment surface (all optional; the dev
# flow works with none of these set). Deployment vars live in
# deploy/.env.example. Prefix convention: RATER_*.

# ── Core paths + wiring ────────────────────────────────────────────
# SQLite database (created on first boot).
#RATER_DB_PATH=~/.openrater/openrater.db
# Where the server reaches the scoring engine (pnpm dev:scoring).
#RATER_SCORING_URL=http://127.0.0.1:8080
# Comma-separated CORS allowlist (defaults to the dev Vite hosts).
#RATER_CORS_ORIGINS=http://localhost:5173

# ── Behavior toggles ───────────────────────────────────────────────
# Require API keys on /quote (off by default; keys are managed in-app).
#RATER_QUOTE_REQUIRE_KEY=1
# Idempotency-Key response-cache TTL, hours (default 24).
#RATER_IDEMPOTENCY_TTL_HOURS=24
# Forward-compat SQL dialect switch (sqlite is the only shipped one).
#RATER_DB_DIALECT=sqlite

# ── Logging ────────────────────────────────────────────────────────
#RATER_LOG_FORMAT=pretty   # pretty | json
#RATER_LOG_LEVEL=INFO

# ── Seeding (deploy overlay + desktop runtime only) ────────────────
# The plain dev server does not read these — it starts empty; load the
# demo with scripts/plan_fixture.py (see CONTRIBUTING.md).
#   1 = seed the Meridian demo if absent · reset = restore each boot ·
#   0 = ship empty
#RATER_SEED_COLD_TEST=1
# Fixture JSON or directory the seeder reads (defaults to the bundled
# docs/fixtures/).
#RATER_COLD_TEST_FIXTURE=docs/fixtures

# ── MCP server / agent loop (services/mcp) ─────────────────────────
# Where the MCP server reaches the platform + the review UI.
#RATER_API_URL=http://127.0.0.1:8001
#RATER_APP_URL=http://localhost:5173
# API key the MCP server sends on /quote when key-gating is on.
#RATER_API_KEY=

# ── Private acceptance hook (never committed content) ──────────────
# Path to a LOCAL workbook used as an extra acceptance gate on your
# own box — real filings stay on your machine (see CONTRIBUTING.md
# content rules).
#RATER_ACCEPTANCE_WORKBOOK=

# ── Optional enrichment connectors (off when unset) ────────────────
#RATER_LIGHTBOX_API_KEY=
#RATER_GOOGLE_MAPS_API_KEY=
